JWT_SECRET=replace-with-a-long-random-string
ENCRYPTION_KEY=replace-with-a-base64-32-byte-key

# Everything below is only needed outside Development (appsettings.Development.json
# supplies dev-only defaults for these). appsettings.{Production,UAT}.json ship these
# blank on purpose — set the real values as environment variables (or a .env file with
# these exact keys) on the deployment host, never commit them. The double-underscore
# is ASP.NET Core's standard way of addressing a nested appsettings key from an env var.
# ConnectionStrings__DefaultConnection=Host=...;Port=...;Database=...;Username=...;Password=...
# ConnectionStrings__MongoConnection=mongodb://...
# Cors__AllowedOrigins__0=https://uat.govoylo.com
# FlyshopSettings__BaseUrl=...
# FlyshopSettings__UserId=...
# FlyshopSettings__Password=...
# FlyshopSettings__IpAddress=...
# FlyshopSettings__ImeiNumber=...
# FlyshopSettings__CustomerMobile=...
# TripjackSettings__BaseUrl=...
# TripjackSettings__UserId=...
# TripjackSettings__Password=...
# TripjackSettings__IpAddress=...
# TripjackSettings__ImeiNumber=...
# SmtpSettings__Host=...
# SmtpSettings__Port=587
# SmtpSettings__SenderEmail=...
# SmtpSettings__Username=...
# SmtpSettings__Password=...
